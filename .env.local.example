# Supabase project for Enlivo's own careers/application pipeline.
# IMPORTANT: use a separate Supabase project from any client project (e.g. CareerPlanet) —
# this is Enlivo's internal data, it should not share infrastructure with client work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER prefix with NEXT_PUBLIC_. Used by the
# admin dashboard to read/update applications, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin/applications dashboard. Plain text is fine here —
# it's compared server-side only, never sent to the browser.
ADMIN_PASSWORD=
